// ── Firebase Storage Rules ────────────────────────────────────────────────────
// Deploy via: Firebase Console → Storage → Rules
// Or via CLI: firebase deploy --only storage
//
// These rules allow any authenticated user to read/write product photos.
// Only files under products/{productId}/photo.jpg are allowed.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product photos — any authenticated user can read; write restricted to authenticated
    match /products/{productId}/photo.jpg {
      allow read:  if true;                          // Public read — needed for <img> tags
      allow write: if request.auth != null           // Must be logged in
                   && request.resource.size < 2 * 1024 * 1024   // Max 2MB
                   && request.resource.contentType.matches('image/.*'); // Images only
      allow delete: if request.auth != null;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
